# dev: 개발·시연 환경. 그 외 값이면 운영으로 보고 JWT_SECRET을 요구한다.
APP_ENV=dev
# 앱 접속 정보. RLS가 적용되는 앱 계정(bjk_app 역할 소속)
DATABASE_URL=postgresql+psycopg://bjk_app_login:bjk_app_login@localhost:5433/bjk
# 마이그레이션·시드용 소유자 계정 (비우면 DATABASE_URL 사용)
ADMIN_DATABASE_URL=postgresql+psycopg://bjk:bjk@localhost:5433/bjk
# 배치 예약 동시 실행 작업 수 (DB 연결 풀도 같은 크기)
# SCHEDULER_WORKERS=2
# 운영에서는 32자 이상 임의 값 필수
# JWT_SECRET=
# DB 테스트용 서버 (비우면 DB 테스트 생략). 테스트마다 임시 DB를 만들고 지운다.
TEST_DATABASE_URL=postgresql+psycopg://bjk:bjk@localhost:5433/postgres
# 테스트 DB 정렬 로케일 (기본 en_US.UTF-8, CI·운영과 같게)
# TEST_DB_LOCALE=en_US.UTF-8
