# dev: 개발·시연 환경. 그 외 값이면 운영으로 보고 JWT_SECRET을 요구한다.
APP_ENV=dev
# 앱 접속 정보. RLS가 적용되는 앱 계정(bjk_app 역할 소속)
DATABASE_URL=postgresql+psycopg://bjk_app_login:bjk_app_login@localhost:5433/bjk
# 마이그레이션·시드용 소유자 계정 (비우면 DATABASE_URL 사용)
ADMIN_DATABASE_URL=postgresql+psycopg://bjk:bjk@localhost:5433/bjk
# 배치 예약 동시 실행 작업 수 (DB 연결 풀도 같은 크기)
# SCHEDULER_WORKERS=2
# 초대 QR 주소(join_url)에 쓰는 웹 앱 주소 (기본 https://app.baljukok.kr)
# WEB_BASE_URL=
# server → ai 주소. 비우면 ai를 부르지 않는다 (docs/ai-integration.md)
AI_BASE_URL=http://localhost:8001
# 새벽 배치의 환율·해상운임·공휴일 외부 수집 (기본 true). 끄면 직전 값, 처음이면 시드 CSV
# EXTERNAL_FETCH=true
# 운영에서는 32자 이상 임의 값 필수
# JWT_SECRET=
# DB 테스트용 서버 (비우면 DB 테스트 생략). 테스트마다 임시 DB를 만들고 지운다.
TEST_DATABASE_URL=postgresql+psycopg://bjk:bjk@localhost:5433/postgres
# 테스트 DB 정렬 로케일 (기본 en_US.UTF-8, CI·운영과 같게)
# TEST_DB_LOCALE=en_US.UTF-8
# ai: LLM·임베딩은 Bedrock(AWS 기본 자격 증명 체인, EC2에서는 IAM Role). 설정은 docs/ai-work-rules.md
AWS_REGION=ap-northeast-3
# Bedrock 모델 (global 추론 프로필. global.anthropic.claude-sonnet-4-6도 가능)
# BEDROCK_CHAT_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# 있으면 LLM 재시도 폴백으로만 쓴다. 키는 커밋하지 않는다.
# GEMINI_API_KEY=
# 웹 푸시 VAPID 키 (비우면 구독만 저장하고 발송하지 않음). 개인 키는 커밋하지 않는다.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@baljukok.kr
